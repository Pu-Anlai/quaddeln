[Unit]
Description=Radicale DAV server

[Container]
ContainerName=radicale
Image=docker.io/tomsquest/docker-radicale:3.5.0.1
PublishPort=5232:5232
RunInit=true
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddCapability=SETUID SETGID CHOWN KILL
PidsLimit=50
HealthCmd=curl -f http://127.0.0.1:5232 || exit 1
HealthInterval=30s
HealthRetries=3
# This folder needs to exist on the host.
Volume=%h/radicale/data:/data
# Set authentication options in the config file on the host.
Volume=%h/radicale/config:/config:ro

[Service]
Restart=always
MemoryHigh=256M

[Install]
WantedBy=default.target
[Unit]
Description=Continuous file synchronization program

[Container]
ContainerName=syncthing
Image=docker.io/syncthing/syncthing:2.0
PublishPort=8384:8384
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp
PublishPort=21027:21027/udp
Volume=%h/syncthing:/var/syncthing
HostName={-{syncthing_hostname}-}
Environment=PUID={-{`id -u`}-} PGID={-{`id -g`}-}
UserNS=keep-id

[Service]
Restart=always

[Install]
WantedBy=default.target
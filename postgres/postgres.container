[Unit]
Description=Postgres container for shared service usage

[Container]
ContainerName=postgres-shared
Image=docker.io/postgres:17.6
# fill in random password here
Environment=TZ POSTGRES_PASSWORD={-{postgres_password}-}
Volume=postgres-data.volume:/var/lib/postgresql/data
Network=postgres-net.network

[Service]
Restart=always

[Install]
WantedBy=default.target
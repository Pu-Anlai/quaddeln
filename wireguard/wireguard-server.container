[Unit]
Description=Simple yet fast and modern VPN

[Container]
ContainerName=wireguard-server
Image=lscr.io/linuxserver/wireguard
AddCapability=NET_ADMIN SYS_MODULE
Environment=PUID={-{`id -u`}-} PGID={-{`id -g`}-} TZ={-{`timedatectl show --value --property=Timezone`}-} SERVERURL={-{wireguard_host_name}-} PEERS={-{wireguard_peers}-} SERVERPORT=51820 LOG_CONFS=true
Volume=%h/wireguard/config:/config
PublishPort=51820:51820/udp

[Service]
Restart=always

[Install]
WantedBy=default.target
